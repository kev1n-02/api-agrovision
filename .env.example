# Copiar este archivo como .env y poner los valores reales.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Puerto donde corre la API
PORT=3000

# Conexión a PostgreSQL (los mismos datos que usas en DBeaver)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_agrovision
DB_USER=postgres
DB_PASSWORD=tu_contrasena_de_postgres

# Secreto para firmar los tokens JWT: una frase larga que nadie conozca
JWT_SECRET=cambia_esto_por_una_frase_larga_y_secreta
# Tiempo de vida del token (8h = 8 horas)
JWT_EXPIRA=8h

# Servicio Python con el modelo de IA (FastAPI)
ML_URL=http://localhost:8000
# Tiempo máximo de espera de una predicción, en milisegundos
ML_TIEMPO_ESPERA_MS=30000

# Carpeta privada donde se guardan las fotos de los diagnósticos
UPLOADS_DIR=uploads

# Frontends que pueden llamar a la API (separados por coma)
# 4200 = Angular, 8100 = Ionic en el navegador, capacitor/localhost = APK
CORS_ORIGENES=http://localhost:4200,http://localhost:8100,capacitor://localhost,http://localhost
